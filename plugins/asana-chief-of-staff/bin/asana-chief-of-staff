#!/usr/bin/env python3
import argparse, json, os, sys, urllib.error, urllib.parse, urllib.request
BASE="https://app.asana.com/api/1.0"
def req(method,path,payload=None):
    token=os.environ.get("ASANA_TOKEN")
    if not token: raise SystemExit("ASANA_TOKEN is required")
    data=None
    if payload is not None: data=json.dumps({"data":payload}).encode()
    r=urllib.request.Request(BASE+path,data=data,method=method,headers={"Authorization":"Bearer "+token,"Content-Type":"application/json"})
    try:
        with urllib.request.urlopen(r,timeout=20) as response: return json.load(response)
    except urllib.error.HTTPError as e: raise SystemExit(f"Asana API {e.code}: {e.read().decode(errors='replace')}")
def gid(name):
    value=os.environ.get(name)
    if not value: raise SystemExit(f"{name} is required")
    return value
def main():
    p=argparse.ArgumentParser(prog="asana-chief-of-staff"); sub=p.add_subparsers(dest="cmd",required=True)
    sub.add_parser("health"); sub.add_parser("project"); sub.add_parser("tasks")
    c=sub.add_parser("create"); c.add_argument("--name",required=True); c.add_argument("--notes",default="")
    c=sub.add_parser("comment"); c.add_argument("--task",required=True); c.add_argument("--text",required=True)
    a=p.parse_args()
    if a.cmd=="health": out=req("GET","/users/me")
    elif a.cmd=="project": out=req("GET","/projects/"+gid("ASANA_PROJECT_GID"))
    elif a.cmd=="tasks": out=req("GET","/projects/%s/tasks?opt_fields=name,completed,notes"%gid("ASANA_PROJECT_GID"))
    elif a.cmd=="create": out=req("POST","/tasks",{"name":a.name,"notes":a.notes,"projects":[gid("ASANA_PROJECT_GID")]})
    else: out=req("POST","/tasks/%s/stories"%a.task,{"text":a.text})
    print(json.dumps(out,indent=2))
if __name__=="__main__": main()
