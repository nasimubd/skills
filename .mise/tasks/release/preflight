#
#  Gating failures set the exit code. Informational findings are reported in
#  their own section and deliberately do not, so that the exit code answers
#  exactly one question: may this release proceed.
# ═══════════════════════════════════════════════════════════════════════════
echo ""
if [[ "$PREFLIGHT_INFORMATIONAL_WARNING_COUNT" -gt 0 ]]; then
    echo "─── Informational findings ($PREFLIGHT_INFORMATIONAL_WARNING_COUNT) — do NOT block the release ───"
    for informational_warning_label in "${PREFLIGHT_INFORMATIONAL_WARNING_LABELS[@]}"; do
        echo "  ⚠ $informational_warning_label"
    done
    echo ""
fi

if [[ "$PREFLIGHT_GATING_FAILURE_COUNT" -gt 0 ]]; then
    echo "═══════════════════════════════════════════════════════════"
    echo "  ✗ Preflight FAILED — $PREFLIGHT_GATING_FAILURE_COUNT gating check(s)"
    echo "═══════════════════════════════════════════════════════════"
    for gating_failure_label in "${PREFLIGHT_GATING_FAILURE_LABELS[@]}"; do
        echo "  ✗ $gating_failure_label"
    done
    echo ""
    echo "  ($PREFLIGHT_INFORMATIONAL_WARNING_COUNT informational finding(s) did not affect this verdict.)"
    echo ""
    exit 1
fi

echo "═══════════════════════════════════════════════════════════"
echo "  ✓ Preflight PASSED — all gating checks green"
echo "═══════════════════════════════════════════════════════════"
echo "  Gating: 7 checks run, 0 failed."
echo "  Informational: $PREFLIGHT_INFORMATIONAL_WARNING_COUNT finding(s), none blocking."
echo ""
