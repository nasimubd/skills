# Line endings and diff behaviour.
#
# Normalise everything on the way in and check everything out with LF. Shell
# scripts and mise file-tasks are executed directly; a CRLF line ending makes
# the kernel look for an interpreter named "bash\r" and the failure message
# names neither the file nor the carriage return.

* text=auto eol=lf

# Executable text. Called out explicitly rather than relying on `text=auto`
# detection, because a script that a heuristic misclassifies as binary is
# checked out byte-for-byte, CRLF and all.
*.sh       text eol=lf
*.bash     text eol=lf

# Generated artifacts.
#
# `linguist-generated=true` keeps them out of the language statistics and
# collapses them by default in pull-request diffs; `-diff` stops git from
# printing the whole file into a terminal diff. Neither is ever hand-edited:
# CHANGELOG.md is written by @semantic-release/changelog from the commit range,
# and a lockfile is written by its package manager.
CHANGELOG.md       linguist-generated=true -diff
package-lock.json  linguist-generated=true -diff
bun.lock           linguist-generated=true -diff
bun.lockb          linguist-generated=true -diff binary
pnpm-lock.yaml     linguist-generated=true -diff
yarn.lock          linguist-generated=true -diff
